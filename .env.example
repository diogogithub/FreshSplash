# Example for docker compose and traditional PHP deployments.
FRESHSPLASH_PORT=8080
FRESHSPLASH_NAME=FreshSplash
FRESHSPLASH_TAGLINE=A tiny wallpaper community for friends.
FRESHSPLASH_BASE_URL=http://localhost:8080
FRESHSPLASH_STORAGE_DRIVER=auto
FRESHSPLASH_MAX_UPLOAD_MB=15
FRESHSPLASH_UPLOAD_TOKEN=replace-with-a-unique-long-random-upload-token
FRESHSPLASH_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
